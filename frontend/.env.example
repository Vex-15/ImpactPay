# URL of the ImpactPay API.
#
# NEXT_PUBLIC_API_URL is baked into the client bundle and used for every browser
# call (sign-in, contributions, evidence upload, the Proof Graph).
NEXT_PUBLIC_API_URL=http://localhost:8080

# API_URL is used by server components to read public data during rendering.
# It can be the same value, or an internal address when the API is not publicly
# reachable from the Next.js server.
API_URL=http://localhost:8080
