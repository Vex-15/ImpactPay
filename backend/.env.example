# ---------------------------------------------------------------------------
# ImpactPay environment
#
# Copy this file to `backend/.env` (or export the variables in your shell) and
# fill in the values you actually have. ImpactPay boots with *no* credentials at
# all: PayPal degrades to a labelled simulation and the language model degrades
# to deterministic text. Nothing here is required to run the demo.
#
# Never commit real credentials. `backend/.env` and `.env*.local` are ignored.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# development | demo | production
APP_ENV=development
PORT=8080
# Public base URL of the API. Used to build PayPal return/cancel URLs.
PUBLIC_URL=http://localhost:8080
# Set to 1 to boot with the deterministic demo dataset (see README: DEMO_MODE).
# DEMO_MODE forces APP_ENV=demo.
DEMO_MODE=1

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to run the embedded pure-Go SQLite database.
# Set it to a postgres:// URL to use PostgreSQL instead (recommended for
# deployment). The schema and queries are portable across both.
DATABASE_URL=
SQLITE_PATH=data/impactpay.db
AUTO_MIGRATE=true

# --- Auth -------------------------------------------------------------------
SESSION_TTL=720h
SESSION_COOKIE=ip_session
# Set to true when the API is served over HTTPS.
COOKIE_SECURE=false
# Comma-separated list of browser origins allowed to call the API with cookies.
ALLOWED_ORIGINS=http://localhost:3000

# --- Evidence storage -------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/storage
MAX_UPLOAD_BYTES=10485760

# S3-compatible object storage (used when STORAGE_DRIVER=s3). Evidence object
# keys are content addressed, so the same bytes always map to the same key.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# Set true for MinIO and other path-style endpoints.
S3_FORCE_PATH_STYLE=false
S3_PREFIX=

# --- PayPal (SANDBOX ONLY) --------------------------------------------------
# ImpactPay refuses to start if PAYPAL_BASE_URL does not point at the PayPal
# sandbox. Create sandbox REST credentials at:
#   https://developer.paypal.com/dashboard/applications/sandbox
# When these are absent the payments service runs its deterministic simulated
# rail and every artefact it writes is flagged simulated=1 in the API and
# labelled "Sandbox simulation" in the UI.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Required to verify inbound webhook signatures. Without it, webhooks are
# recorded and rejected rather than trusted.
PAYPAL_WEBHOOK_ID=
# The PayPal account's settlement currency. Project budgets may be in another
# currency; conversions use a configured indicative rate, never a live feed.
PAYPAL_CURRENCY=USD
# Indicative INR-per-USD rate used when a project budget is converted into the
# account currency. ImpactPay stores the rate and both amounts on every release;
# it is never presented as a live exchange rate.
PAYPAL_FX_RATE_INR_PER_USD=83.00

# --- AI (optional) ----------------------------------------------------------
# Leave AI_API_KEY empty for fully deterministic narratives.
# The model is only ever allowed to *rephrase* figures that Go code computed:
# it cannot change a quantity, a check, a citation or a recommendation.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=45s

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
